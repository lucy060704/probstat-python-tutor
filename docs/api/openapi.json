{
  "components": {
    "schemas": {
      "ApiErrorCode": {
        "description": "Stable categories clients may handle without parsing prose.",
        "enum": [
          "invalid_json",
          "invalid_request",
          "payload_too_large",
          "unsupported_media_type",
          "not_found",
          "method_not_allowed",
          "state_conflict",
          "service_unavailable",
          "internal_error"
        ],
        "title": "ApiErrorCode",
        "type": "string"
      },
      "ApiErrorDetail": {
        "additionalProperties": false,
        "description": "Safe structured error; invalid values and exception messages are excluded.",
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ApiErrorCode"
          },
          "invalid_fields": {
            "default": [],
            "items": {
              "type": "string"
            },
            "title": "Invalid Fields",
            "type": "array"
          },
          "message_zh": {
            "title": "Message Zh",
            "type": "string"
          },
          "retryable": {
            "title": "Retryable",
            "type": "boolean"
          }
        },
        "required": [
          "code",
          "message_zh",
          "retryable"
        ],
        "title": "ApiErrorDetail",
        "type": "object"
      },
      "ApiErrorResponse": {
        "additionalProperties": false,
        "description": "Versioned error envelope returned for every non-2xx API response.",
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ApiErrorDetail"
          },
          "request_id": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{7,127}$",
            "title": "Request Id",
            "type": "string"
          },
          "schema_version": {
            "const": "1.0.0",
            "default": "1.0.0",
            "title": "Schema Version",
            "type": "string"
          }
        },
        "required": [
          "request_id",
          "error"
        ],
        "title": "ApiErrorResponse",
        "type": "object"
      },
      "CapabilityDimension": {
        "description": "The four separately tracked learner capabilities.",
        "enum": [
          "concept",
          "calculation",
          "python",
          "interpretation"
        ],
        "title": "CapabilityDimension",
        "type": "string"
      },
      "ConceptId": {
        "description": "Published, deterministically graded knowledge points.",
        "enum": [
          "data_quality",
          "mean_median",
          "variance_std",
          "probability_simulation",
          "common_distributions",
          "joint_correlation",
          "sampling_standard_error",
          "confidence_interval",
          "hypothesis_testing"
        ],
        "title": "ConceptId",
        "type": "string"
      },
      "ContentReviewStatus": {
        "description": "Human review state; only a teacher may move content to approved.",
        "enum": [
          "draft",
          "pending_teacher_review",
          "approved"
        ],
        "title": "ContentReviewStatus",
        "type": "string"
      },
      "DeliveryMode": {
        "description": "How the learner-facing explanation was delivered for this submission.",
        "enum": [
          "deterministic_offline",
          "model_enhanced",
          "model_fallback",
          "safety_isolated"
        ],
        "title": "DeliveryMode",
        "type": "string"
      },
      "DiagnoseRequest": {
        "additionalProperties": false,
        "description": "One deterministic learning submission.",
        "properties": {
          "anonymous_profile_id": {
            "pattern": "^(?:local|api)_anon_[0-9a-f]{16,64}$",
            "title": "Anonymous Profile Id",
            "type": "string"
          },
          "hint_level": {
            "maximum": 4,
            "minimum": 0,
            "title": "Hint Level",
            "type": "integer"
          },
          "idempotency_key": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{7,127}$",
            "title": "Idempotency Key",
            "type": "string"
          },
          "question_id": {
            "pattern": "^[a-z0-9_]{3,100}$",
            "title": "Question Id",
            "type": "string"
          },
          "request_id": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{7,127}$",
            "title": "Request Id",
            "type": "string"
          },
          "schema_version": {
            "const": "1.0.0",
            "title": "Schema Version",
            "type": "string"
          },
          "submission": {
            "$ref": "#/components/schemas/LearnerSubmission"
          }
        },
        "required": [
          "schema_version",
          "request_id",
          "idempotency_key",
          "anonymous_profile_id",
          "question_id",
          "submission",
          "hint_level"
        ],
        "title": "DiagnoseRequest",
        "type": "object"
      },
      "DiagnoseResponse": {
        "additionalProperties": false,
        "description": "Versioned deterministic report envelope.",
        "properties": {
          "idempotency_key": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{7,127}$",
            "title": "Idempotency Key",
            "type": "string"
          },
          "report": {
            "$ref": "#/components/schemas/DiagnosticReport"
          },
          "request_id": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{7,127}$",
            "title": "Request Id",
            "type": "string"
          },
          "schema_version": {
            "const": "1.0.0",
            "default": "1.0.0",
            "title": "Schema Version",
            "type": "string"
          }
        },
        "required": [
          "request_id",
          "idempotency_key",
          "report"
        ],
        "title": "DiagnoseResponse",
        "type": "object"
      },
      "DiagnosticReport": {
        "additionalProperties": false,
        "description": "Structured tutor output whose factual fields come from deterministic tools.",
        "properties": {
          "delivery_message_zh": {
            "default": "本次使用确定性本地诊断。",
            "title": "Delivery Message Zh",
            "type": "string"
          },
          "delivery_mode": {
            "$ref": "#/components/schemas/DeliveryMode",
            "default": "deterministic_offline"
          },
          "dimension_scores": {
            "$ref": "#/components/schemas/MasteryScores"
          },
          "evidence": {
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "title": "Evidence",
            "type": "array"
          },
          "feedback": {
            "title": "Feedback",
            "type": "string"
          },
          "grader_findings": {
            "items": {
              "$ref": "#/components/schemas/EvidenceFinding"
            },
            "title": "Grader Findings",
            "type": "array"
          },
          "hint_level": {
            "maximum": 4,
            "minimum": 0,
            "title": "Hint Level",
            "type": "integer"
          },
          "knowledge_citations": {
            "items": {
              "$ref": "#/components/schemas/KnowledgeCitation"
            },
            "title": "Knowledge Citations",
            "type": "array"
          },
          "knowledge_context_message": {
            "default": "尚未检索本地知识库。",
            "title": "Knowledge Context Message",
            "type": "string"
          },
          "knowledge_context_status": {
            "$ref": "#/components/schemas/KnowledgeContextStatus",
            "default": "no_match"
          },
          "learner_evidence": {
            "items": {
              "$ref": "#/components/schemas/LearnerEvidence"
            },
            "title": "Learner Evidence",
            "type": "array"
          },
          "misconception_tags": {
            "items": {
              "type": "string"
            },
            "title": "Misconception Tags",
            "type": "array"
          },
          "next_question_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Question Id"
          },
          "overall_correctness": {
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Overall Correctness",
            "type": "number"
          },
          "question_id": {
            "title": "Question Id",
            "type": "string"
          },
          "reasoning_assessment": {
            "$ref": "#/components/schemas/ReasoningAssessment"
          },
          "recommendation_dimension": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/CapabilityDimension"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "recommendation_kind": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/RecommendationKind"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "recommendation_rule_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Recommendation Rule Id"
          },
          "recommended_action": {
            "title": "Recommended Action",
            "type": "string"
          },
          "uncertainty": {
            "title": "Uncertainty",
            "type": "string"
          }
        },
        "required": [
          "question_id",
          "overall_correctness",
          "dimension_scores",
          "evidence",
          "misconception_tags",
          "feedback",
          "hint_level",
          "recommended_action",
          "next_question_id",
          "uncertainty"
        ],
        "title": "DiagnosticReport",
        "type": "object"
      },
      "EvidenceFinding": {
        "additionalProperties": false,
        "description": "One rule-backed finding tied to an exact learner-authored source.",
        "properties": {
          "dimension": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/CapabilityDimension"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "message_zh": {
            "minLength": 1,
            "title": "Message Zh",
            "type": "string"
          },
          "misconception_tag": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Misconception Tag"
          },
          "quote": {
            "anyOf": [
              {
                "maxLength": 500,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Quote"
          },
          "rule_id": {
            "minLength": 1,
            "pattern": "^[a-z0-9_]+$",
            "title": "Rule Id",
            "type": "string"
          },
          "source": {
            "$ref": "#/components/schemas/SubmissionField"
          },
          "verdict": {
            "$ref": "#/components/schemas/EvidenceVerdict"
          }
        },
        "required": [
          "rule_id",
          "source",
          "verdict",
          "message_zh"
        ],
        "title": "EvidenceFinding",
        "type": "object"
      },
      "EvidenceVerdict": {
        "description": "Deterministic interpretation of one observable submission fragment.",
        "enum": [
          "supports",
          "contradicts",
          "insufficient",
          "irrelevant",
          "unsafe"
        ],
        "title": "EvidenceVerdict",
        "type": "string"
      },
      "HealthResponse": {
        "additionalProperties": false,
        "description": "Minimal health data safe to expose through a future HTTPS edge.",
        "properties": {
          "local_knowledge_base_available": {
            "title": "Local Knowledge Base Available",
            "type": "boolean"
          },
          "offline_core_available": {
            "const": true,
            "default": true,
            "title": "Offline Core Available",
            "type": "boolean"
          },
          "optional_model_status": {
            "$ref": "#/components/schemas/OptionalModelStatus"
          },
          "request_id": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{7,127}$",
            "title": "Request Id",
            "type": "string"
          },
          "schema_version": {
            "const": "1.0.0",
            "default": "1.0.0",
            "title": "Schema Version",
            "type": "string"
          },
          "service_version": {
            "pattern": "^\\d+\\.\\d+\\.\\d+$",
            "title": "Service Version",
            "type": "string"
          },
          "status": {
            "const": "ok",
            "default": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "request_id",
          "service_version",
          "optional_model_status",
          "local_knowledge_base_available"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "HintRequest": {
        "additionalProperties": false,
        "description": "Request exactly one progressive hint level.",
        "properties": {
          "hint_level": {
            "maximum": 4,
            "minimum": 1,
            "title": "Hint Level",
            "type": "integer"
          },
          "idempotency_key": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{7,127}$",
            "title": "Idempotency Key",
            "type": "string"
          },
          "question_id": {
            "pattern": "^[a-z0-9_]{3,100}$",
            "title": "Question Id",
            "type": "string"
          },
          "request_id": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{7,127}$",
            "title": "Request Id",
            "type": "string"
          },
          "schema_version": {
            "const": "1.0.0",
            "title": "Schema Version",
            "type": "string"
          }
        },
        "required": [
          "schema_version",
          "request_id",
          "idempotency_key",
          "question_id",
          "hint_level"
        ],
        "title": "HintRequest",
        "type": "object"
      },
      "HintResponse": {
        "additionalProperties": false,
        "description": "One progressive hint without hidden answer fields.",
        "properties": {
          "complete_explanation_revealed": {
            "title": "Complete Explanation Revealed",
            "type": "boolean"
          },
          "hint_level": {
            "maximum": 4,
            "minimum": 1,
            "title": "Hint Level",
            "type": "integer"
          },
          "hint_zh": {
            "title": "Hint Zh",
            "type": "string"
          },
          "idempotency_key": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{7,127}$",
            "title": "Idempotency Key",
            "type": "string"
          },
          "question_id": {
            "pattern": "^[a-z0-9_]{3,100}$",
            "title": "Question Id",
            "type": "string"
          },
          "request_id": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{7,127}$",
            "title": "Request Id",
            "type": "string"
          },
          "schema_version": {
            "const": "1.0.0",
            "default": "1.0.0",
            "title": "Schema Version",
            "type": "string"
          }
        },
        "required": [
          "request_id",
          "idempotency_key",
          "question_id",
          "hint_level",
          "hint_zh",
          "complete_explanation_revealed"
        ],
        "title": "HintResponse",
        "type": "object"
      },
      "KnowledgeCitation": {
        "additionalProperties": false,
        "description": "One auditable citation produced by the deterministic local retriever.",
        "properties": {
          "chunk_id": {
            "pattern": "^[a-z][a-z0-9_.:@-]*$",
            "title": "Chunk Id",
            "type": "string"
          },
          "citation_id": {
            "pattern": "^R[1-5]$",
            "title": "Citation Id",
            "type": "string"
          },
          "content_checksum": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "title": "Content Checksum",
            "type": "string"
          },
          "min_hint_level": {
            "maximum": 4,
            "minimum": 1,
            "title": "Min Hint Level",
            "type": "integer"
          },
          "quote": {
            "anyOf": [
              {
                "maxLength": 600,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Quote"
          },
          "review_status": {
            "$ref": "#/components/schemas/ContentReviewStatus"
          },
          "section": {
            "pattern": "^[a-z][a-z0-9_]*$",
            "title": "Section",
            "type": "string"
          },
          "source_checksum": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "title": "Source Checksum",
            "type": "string"
          },
          "source_id": {
            "pattern": "^[a-z][a-z0-9_]*$",
            "title": "Source Id",
            "type": "string"
          },
          "source_title": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Source Title",
            "type": "string"
          },
          "source_version": {
            "pattern": "^\\d+\\.\\d+\\.\\d+$",
            "title": "Source Version",
            "type": "string"
          }
        },
        "required": [
          "source_id",
          "source_version",
          "source_title",
          "citation_id",
          "chunk_id",
          "section",
          "content_checksum",
          "source_checksum",
          "min_hint_level",
          "review_status"
        ],
        "title": "KnowledgeCitation",
        "type": "object"
      },
      "KnowledgeContextStatus": {
        "description": "Whether the deterministic local knowledge base found usable context.",
        "enum": [
          "matched",
          "no_match",
          "index_unavailable",
          "policy_blocked"
        ],
        "title": "KnowledgeContextStatus",
        "type": "string"
      },
      "LearnerEvidence": {
        "additionalProperties": false,
        "description": "One exact, source-labelled excerpt from a learner submission.",
        "properties": {
          "quote": {
            "maxLength": 500,
            "minLength": 1,
            "title": "Quote",
            "type": "string"
          },
          "source": {
            "$ref": "#/components/schemas/SubmissionField"
          }
        },
        "required": [
          "source",
          "quote"
        ],
        "title": "LearnerEvidence",
        "type": "object"
      },
      "LearnerSubmission": {
        "additionalProperties": false,
        "description": "Validated learner-authored text; Python code is never executed.",
        "properties": {
          "answer": {
            "title": "Answer",
            "type": "string"
          },
          "python_code": {
            "default": "",
            "title": "Python Code",
            "type": "string"
          },
          "reasoning": {
            "default": "",
            "title": "Reasoning",
            "type": "string"
          }
        },
        "required": [
          "answer"
        ],
        "title": "LearnerSubmission",
        "type": "object"
      },
      "MasteryScores": {
        "additionalProperties": false,
        "description": "Mastery scores for one knowledge point.",
        "properties": {
          "calculation": {
            "default": 0.5,
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Calculation",
            "type": "number"
          },
          "concept": {
            "default": 0.5,
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Concept",
            "type": "number"
          },
          "interpretation": {
            "default": 0.5,
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Interpretation",
            "type": "number"
          },
          "python": {
            "default": 0.5,
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Python",
            "type": "number"
          }
        },
        "title": "MasteryScores",
        "type": "object"
      },
      "OptionalModelStatus": {
        "description": "Whether optional online explanation is configured, without exposing secrets.",
        "enum": [
          "disabled",
          "enabled",
          "degraded"
        ],
        "title": "OptionalModelStatus",
        "type": "string"
      },
      "PublicQuestion": {
        "additionalProperties": false,
        "description": "Question fields allowed across the API; answers and grading rules are absent.",
        "properties": {
          "concept_id": {
            "$ref": "#/components/schemas/ConceptId"
          },
          "dataset": {
            "additionalProperties": true,
            "title": "Dataset",
            "type": "object"
          },
          "difficulty": {
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Difficulty",
            "type": "number"
          },
          "id": {
            "pattern": "^[a-z0-9_]{3,100}$",
            "title": "Id",
            "type": "string"
          },
          "prompt": {
            "title": "Prompt",
            "type": "string"
          },
          "question_type": {
            "$ref": "#/components/schemas/QuestionType"
          },
          "title": {
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "concept_id",
          "question_type",
          "difficulty",
          "prompt",
          "dataset"
        ],
        "title": "PublicQuestion",
        "type": "object"
      },
      "QuestionType": {
        "description": "The learning dimension primarily observed by a question.",
        "enum": [
          "concept",
          "python",
          "interpretation"
        ],
        "title": "QuestionType",
        "type": "string"
      },
      "ReasoningAssessment": {
        "additionalProperties": false,
        "description": "Reasoning quality reported separately from answer correctness.",
        "properties": {
          "message_zh": {
            "default": "本题未配置单独的理由判断。",
            "title": "Message Zh",
            "type": "string"
          },
          "provided": {
            "default": false,
            "title": "Provided",
            "type": "boolean"
          },
          "required": {
            "default": false,
            "title": "Required",
            "type": "boolean"
          },
          "verdict": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/EvidenceVerdict"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          }
        },
        "title": "ReasoningAssessment",
        "type": "object"
      },
      "RecommendRequest": {
        "additionalProperties": false,
        "description": "Request a safe public question for one anonymous profile and concept.",
        "properties": {
          "anonymous_profile_id": {
            "pattern": "^(?:local|api)_anon_[0-9a-f]{16,64}$",
            "title": "Anonymous Profile Id",
            "type": "string"
          },
          "concept_id": {
            "$ref": "#/components/schemas/ConceptId"
          },
          "idempotency_key": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{7,127}$",
            "title": "Idempotency Key",
            "type": "string"
          },
          "request_id": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{7,127}$",
            "title": "Request Id",
            "type": "string"
          },
          "schema_version": {
            "const": "1.0.0",
            "title": "Schema Version",
            "type": "string"
          }
        },
        "required": [
          "schema_version",
          "request_id",
          "idempotency_key",
          "anonymous_profile_id",
          "concept_id"
        ],
        "title": "RecommendRequest",
        "type": "object"
      },
      "RecommendResponse": {
        "additionalProperties": false,
        "description": "Public next-question envelope.",
        "properties": {
          "idempotency_key": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{7,127}$",
            "title": "Idempotency Key",
            "type": "string"
          },
          "question": {
            "$ref": "#/components/schemas/PublicQuestion"
          },
          "request_id": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{7,127}$",
            "title": "Request Id",
            "type": "string"
          },
          "schema_version": {
            "const": "1.0.0",
            "default": "1.0.0",
            "title": "Schema Version",
            "type": "string"
          }
        },
