# Copy variable names into your shell or a local secret manager.
# Never put a real API key in a committed file.
OPENAI_API_KEY=
OPENAI_MODEL=

# Optional online-explanation reliability limits. Defaults are shown below.
# Retries wrap only the model explanation; they never replay the SQLite commit.
MODEL_TIMEOUT_SECONDS=8
MODEL_MAX_ATTEMPTS=2
MODEL_RETRY_BASE_DELAY_SECONDS=0.05
MODEL_CIRCUIT_FAILURE_THRESHOLD=3
MODEL_CIRCUIT_OPEN_SECONDS=30
